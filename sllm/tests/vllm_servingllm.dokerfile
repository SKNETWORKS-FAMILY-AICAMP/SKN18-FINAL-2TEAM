FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HOME=/workspace/.cache/huggingface

# --no-cache-dir을 써도 이미 이미지에 설치된 vllm은 남아 있고, 
# 추가로 캐시 디렉토리를 넣지 않아 이미지가 더 가벼워집니다.
RUN pip install vllm==0.13.0 --no-cache-dir
RUN pip install --upgrade huggingface_hub

WORKDIR /workspace

# 시작 스크립트 생성
# 런타임 환경변수로 모델 및 설정 변경 가능:
# - MODEL_NAME: 사용할 모델명 (기본값: google/gemma-3-1b-it)
# - PORT: 서버 포트 (기본값: 7860)
#   * 같은 인스턴스에서 여러 Pod를 동시에 실행하려면 각 Pod마다 다른 PORT 설정 필요
#   * 예: Pod1=7860, Pod2=7861, Pod3=7862
# - MAX_MODEL_LEN: 최대 모델 길이 (기본값: 8192)
# - DTYPE: 모델 데이터 타입 (기본값: auto, 옵션: auto, float16, bfloat16)
# - GPU_MEMORY_UTILIZATION: GPU 메모리 사용률 (기본값: 0.9, 0.0~1.0)
# - TENSOR_PARALLEL_SIZE: 텐서 병렬 크기 (기본값: 1, 멀티 GPU인 경우 설정)
# - TRUST_REMOTE_CODE: 원격 코드 신뢰 여부 (기본값: true, true/false)
# - HF_TOKEN: HuggingFace 토큰 (private/gated 모델인 경우)
RUN echo '#!/bin/bash\n\
set -e\n\
if [ -n "$HF_TOKEN" ]; then\n\
    echo "Logging in to HuggingFace at runtime..."\n\
    huggingface-cli login --token $HF_TOKEN --add-to-git-credential\n\
    echo "HuggingFace login successful"\n\
else\n\
    echo "No HF_TOKEN provided - using public model or cached credentials"\n\
fi\n\
echo "Starting vLLM server..."\n\
echo "Model: ${MODEL_NAME:-google/gemma-3-1b-it}"\n\
echo "Port: ${PORT:-7860}"\n\
echo "Max Model Length: ${MAX_MODEL_LEN:-8192}"\n\
echo "Dtype: ${DTYPE:-auto}"\n\
echo "GPU Memory Utilization: ${GPU_MEMORY_UTILIZATION:-0.9}"\n\
[ -n "$TENSOR_PARALLEL_SIZE" ] && echo "Tensor Parallel Size: $TENSOR_PARALLEL_SIZE"\n\
VLLM_ARGS=(\n\
    --model ${MODEL_NAME:-google/gemma-3-1b-it}\n\
    --host 0.0.0.0\n\
    --port ${PORT:-7860}\n\
    --dtype ${DTYPE:-auto}\n\
    --max-model-len ${MAX_MODEL_LEN:-8192}\n\
    --gpu-memory-utilization ${GPU_MEMORY_UTILIZATION:-0.9}\n\
)\n\
[ -n "$TENSOR_PARALLEL_SIZE" ] && VLLM_ARGS+=(--tensor-parallel-size $TENSOR_PARALLEL_SIZE)\n\
[ "${TRUST_REMOTE_CODE:-true}" = "true" ] && VLLM_ARGS+=(--trust-remote-code)\n\
exec python -m vllm.entrypoints.openai.api_server "${VLLM_ARGS[@]}"\n\
' > /start-vllm.sh && chmod +x /start-vllm.sh

CMD ["/start-vllm.sh"]