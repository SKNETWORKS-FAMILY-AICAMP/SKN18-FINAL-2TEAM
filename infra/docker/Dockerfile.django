FROM python:3.11-slim

WORKDIR /app

# 시스템 의존성
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 애플리케이션 코드 복사
COPY django_app/ ./django_app/
COPY graph/ ./graph/
# rag/retriver만 복사 (ETL 코드는 Lambda에서 실행되므로 불필요)
COPY rag/retriver/ ./rag/retriver/
# messaging은 django_app/apps/core/queue.py에서 사용
COPY messaging/ ./messaging/
# kg, sllm은 보류 (필요시 추가)
# COPY kg/ ./kg/
# COPY sllm/ ./sllm/

# Entrypoint 스크립트 (자동 마이그레이션 실행)
COPY infra/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Django 설정
WORKDIR /app/django_app
ENV PYTHONPATH=/app

EXPOSE 8000

# Entrypoint에서 마이그레이션 실행 후 Gunicorn 시작
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]

