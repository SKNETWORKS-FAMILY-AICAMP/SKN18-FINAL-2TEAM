FROM python:3.11-slim

WORKDIR /app

# 시스템 의존성 (필요 최소 패키지만)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Python 의존성 (Worker 전용 - 최소 패키지만)
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# Worker에 필요한 코드만 복사
# messaging: Consumer 모듈 포함
COPY messaging/ ./messaging/
# sim_tools/common: 시뮬레이션 공통 유틸
COPY sim_tools/common/ ./sim_tools/common/

# Django 설정 (ORM 사용 시)
COPY django_app/config/ ./django_app/config/
COPY django_app/apps/ ./django_app/apps/
COPY django_app/manage.py ./django_app/manage.py

WORKDIR /app
ENV PYTHONPATH=/app

# Consumer 실행
CMD ["python", "-m", "messaging.workers.main"]

