# 로컬 : dev, AWS : prod
ENVIRONMENT=dev

########################################
# Django Application
########################################
DJANGO_SECRET_KEY=dev-secret-key-123
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Django DB (Postgres)
DATABASE_URL=postgresql://root:root1234@localhost:5432/sknfinaldb


########################################
# PostgreSQL + pgvector
########################################
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sknfinaldb
POSTGRES_USER=root
POSTGRES_PASSWORD=root1234


########################################
# Neo4j (Knowledge Graph)
########################################
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpass    # 원하는 비밀번호로 변경
NEO4J_DATABASE=neo4j        # 기본 DB 이름


########################################
# LLM (OpenAI / Local)
########################################
# OpenAI (기본)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=

# 파인튠 어답터 모델
HF_ADAPTER_REPO_ID={repo-id/model-id}
MODEL_DIR_ADAPTER=models/adapters/{model-id}

# 베이스 모델
HF_BASE_REPO_ID={repo-id/model-id}
MODEL_DIR_BASE=models/base/{model-id}


########################################
# LangGraph / RAG / Retrieval
########################################
VECTOR_TABLE=t_chunk_vector
CHUNK_TABLE=t_chunk
DOCUMENT_TABLE=t_document

RAG_EMBED_MODEL=

########################################
# ETL / Worker Jobs
########################################
# pubmed | nih | protocols
ETL_SOURCE=pubmed
ETL_BATCH_SIZE=50
ETL_OUTPUT_DIR=/app/data/processed
ETL_RAW_DIR=/app/data/raw

# protocols.io 
CLIENT_ACCESS_TOKEN=

DEV_PROCESSED_DIR='./data/processed'
PROD_PROCESSED_DIR='s3://skn18-final-2team-prod/processed'


########################################
# AWS Deployment (optional)
########################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=skn18-final-2team-bucket
AWS_S3_BASE_PATH=data/


########################################
# Email / Notifications
########################################
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=


########################################
# Misc
########################################
LOG_LEVEL=INFO
ENV=development

# 런팟에서 실행하는지 설정
IS_RUNPOD=false

# Google OAuth / Calendar
GOOGLE_CLIENT_ID="입력"
GOOGLE_CLIENT_SECRET="입력"
GOOGLE_REDIRECT_URI=http://localhost:8000/google/oauth2/callback/
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar