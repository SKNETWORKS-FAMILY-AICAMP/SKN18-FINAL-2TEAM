# Jupyter Notebook files should not have line endings converted
*.ipynb text eol=lf

# Python files - use LF line endings
*.py text eol=lf

# Shell scripts - use LF line endings
*.sh text eol=lf

# Configuration files - use LF line endings
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.cypher text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

